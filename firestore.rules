rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything under users/{uid} belongs to that signed-in user and nobody else.
    // Cards and the state document also refuse a write that is older than the stored one
    // (field `t` is the update time), so a device that was offline cannot overwrite newer progress.
    match /users/{uid}/cards/{cardId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.t >= resource.data.t;
    }
    match /users/{uid}/state/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.t >= resource.data.t;
    }
    match /users/{uid}/days/{day} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
